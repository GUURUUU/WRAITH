<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.brycestrosoft.liber80211"
    android:versionCode="1"
    android:versionName="0.1" >

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="23" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.brycestrosoft.liber80211.MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:label="@string/title_activity_about" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <!-- Removed: WRITE_EXTERNAL_STORAGE (log now goes to app-private dir)
         and ACCESS_FINE_LOCATION (never runtime-requested; threw SecurityException
         once targetSdk moved to 23). -->

</manifest>